# Application Configuration
APP_NAME=node-backend-boilerplate
APP_HOST=localhost
APP_SCHEMA=http
APP_ROUTE_PREFIX=/api
APP_PORT=5000
APP_BANNER=true

# Database Configuration (TypeORM)
TYPEORM_CONNECTION=mysql
TYPEORM_HOST=localhost
TYPEORM_PORT=3306
TYPEORM_USERNAME=root
TYPEORM_PASSWORD=password
TYPEORM_DATABASE=boilerplate_db
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
TYPEORM_MIGRATIONS=src/database/migrations/**/*.ts
TYPEORM_MIGRATIONS_DIR=src/database/migrations
TYPEORM_ENTITIES=src/api/models/**/*.ts
TYPEORM_ENTITIES_DIR=src/api/models

# MongoDB Configuration
MONGO_URIS=mongodb://localhost:27017/boilerplate
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_REPLICASET=

# Redis Configuration
REDIS_HOST=localhost:6379
REDIS_CLIENT=redis

# JWT Configuration
JWT_NAME=boilerplate-jwt
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Logging Configuration
LOG_LEVEL=debug
LOG_JSON=false
LOG_OUTPUT=dev

# Swagger Configuration
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/swagger
SWAGGER_FILE=src/api/swagger.json
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin

# Monitor Configuration
MONITOR_ENABLED=true
MONITOR_ROUTE=/monitor
MONITOR_USERNAME=admin
MONITOR_PASSWORD=admin

# CORS Configuration
ORIGIN=*

# Directory Paths
CONTROLLERS=src/api/controllers/**/*Controller.ts
MIDDLEWARES=src/api/middlewares/**/*Middleware.ts
INTERCEPTORS=src/api/interceptors/**/*Interceptor.ts
SUBSCRIBERS=src/api/subscribers/**/*Subscriber.ts
RESOLVERS=src/api/resolvers/**/*Resolver.ts