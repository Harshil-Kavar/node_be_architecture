{
  "name": "node-backend-boilerplate",
  "version": "1.0.0",
  "description": "A comprehensive Node.js backend boilerplate with TypeScript, Express, and MongoDB support",
  "main": "src/app.ts",
  "scripts": {
    "start": "nps",
    "test": "jest",
    "build": "tsc",
    "serve": "nodemon --exec ts-node src/app.ts"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "keywords": [
    "NodeJS",
    "TypeScript",
    "Express",
    "MongoDB",
    "boilerplate",
    "REST API",
    "backend",
    "starter-kit"
  ],
  "dependencies": {
    "bcrypt": "^5.0.1",
    "chalk": "^4.1.2",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.2",
    "commander": "^8.3.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-basic-auth": "^1.2.1",
    "express-status-monitor": "^1.3.4",
    "figlet": "^1.5.2",
    "helmet": "^6.1.5",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "microframework-w3tec": "^0.6.3",
    "mongoose": "^6.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^2.0.22",
    "nps": "^5.10.0",
    "nps-utils": "^1.7.0",
    "redis": "^4.0.6",
    "reflect-metadata": "^0.1.13",
    "routing-controllers": "^0.9.0",
    "serve-favicon": "^2.5.0",
    "swagger-ui-express": "^4.6.3",
    "ts-node": "^10.9.1",
    "typedi": "^0.10.0",
    "typescript": "^4.9.5",
    "uuid": "^9.0.0",
    "winston": "^3.8.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.ts$",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/figlet": "^1.5.6",
    "@types/jest": "^29.5.1",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.195",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^18.16.3",
    "@types/serve-favicon": "^2.5.3",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.1",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0"
  }
}